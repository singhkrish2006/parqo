# Copy to .env.local and fill in. Nothing here is required to run the app
# locally, but shared real-time reports need Supabase and a production launch
# needs a licensed tile provider.

# --- Database (Supabase) ---------------------------------------------------
# Project Settings -> API. The anon key is safe to expose to the browser; it is
# restricted by the row-level-security policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Map tiles ---------------------------------------------------------------
# Any XYZ raster tile URL from a provider you have a plan with, e.g.
#   https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
# Credit line the provider requires (HTML allowed).
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Routing & geocoding (server-side, used by /api/route and /api/geocode) ---
# Defaults are the public OSRM / Nominatim servers, which are fine for
# development only. Point these at your own instances or paid providers.
OSRM_BASE_URL=
NOMINATIM_BASE_URL=
# Nominatim's usage policy requires a contact address in the User-Agent.
GEOCODER_CONTACT_EMAIL=

# --- Site ---------------------------------------------------------------------
# Public origin, used for absolute URLs in link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
